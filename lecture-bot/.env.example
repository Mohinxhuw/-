# --- Required ---
# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Optional ---
# Claude model and effort for writing the summary and questions
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Speech-to-text model. large-v3-turbo is the best speed/accuracy balance on CPU.
WHISPER_MODEL=large-v3-turbo
# cpu or cuda (cuda needs an NVIDIA GPU server; much faster)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
# Seconds of processing per minute of audio, only for the ETA shown to students
WHISPER_SECONDS_PER_AUDIO_MINUTE=35

MAX_LECTURE_MINUTES=150

# Self-hosted Telegram Bot API server: lets students send files up to 2 GB instead of 20 MB.
# Needs TELEGRAM_API_ID and TELEGRAM_API_HASH from https://my.telegram.org (see README).
# TELEGRAM_LOCAL_API_URL=http://telegram-bot-api:8081
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
